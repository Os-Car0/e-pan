# Copy to .env locally; never commit real credentials.
# Neon PostgreSQL: pooled URL for application queries; direct URL for approved migrations.
# Copy the real connection strings from Neon into a local ignored .env or the hosting secret settings.
DATABASE_URL=
DIRECT_URL=
# Generate a unique random secret with at least 32 characters before use.
AUTH_SECRET=
# Optional one-time bootstrap via prisma/create-admin.ts; requires all three.
# The administrator already exists; do not set these permanently on Netlify.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Optional online payments. Keep real provider credentials private.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STORE_PHONE=

# Cloudinary Image & Video API Free. These are server-only variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-only. Set to netlify in Netlify runtime environment variables only.
# Production login fails closed without a trusted connection IP source.
ADMIN_LOGIN_IP_SOURCE=
